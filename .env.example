# ZUI server configuration (all optional; sensible defaults shown)

# HTTP
ZUI_PORT=3000
ZUI_HOST=127.0.0.1
ZUI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Storage
ZUI_DATA_DIR=./.zui-data
ZUI_STORAGE=local            # local | s3
ZUI_MAX_SESSION_BYTES=2147483648   # 2 GiB per transfer
ZUI_MAX_CHUNK_BYTES=4194304        # 4 MiB hard cap per stored chunk
ZUI_SESSION_TTL_MS=86400000         # 24 h session lifetime
ZUI_SWEEP_INTERVAL_MS=600000        # expired-session cleanup loop
ZUI_ACCESS_TOKEN=                  # optional shared bearer token guarding mutations

# Rate limits
ZUI_RATE_LIMIT_GENERAL=300
ZUI_RATE_LIMIT_CHUNKS=1200
ZUI_RATE_LIMIT_SESSIONS=40

# S3 / Cloudflare R2 (used when ZUI_STORAGE=s3)
ZUI_S3_ENDPOINT=
ZUI_S3_REGION=auto
ZUI_S3_BUCKET=zui
ZUI_S3_ACCESS_KEY_ID=
ZUI_S3_SECRET_ACCESS_KEY=
ZUI_S3_FORCE_PATH_STYLE=false